**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android local SDK paths + gradle cache (never commit)
**/android/local.properties
/android/.gradle/

# Flutter / iOS generated (machine-local paths)
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/

# Portfolio screenshots: raw unedited captures stay local, not committed
/docs/screenshots/raw/

# Temporary inspection/preview check images (local scratch, not committed)
/docs/screenshots/_*

# Local scratch / probe tooling (not portfolio surface)
.temp/
/tool/check_*.py
/tool/inspect_*.py
/tool/probe_*.py
/tool/cleanup_*.py
/tool/rename_raw.py
